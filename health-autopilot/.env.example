# ═══════════════════════════════════════════════════════
# Health Autopilot OS — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════

# ─── App ────────────────────────────────────────────────
APP_NAME="Health Autopilot OS"
APP_ENV=production                        # development | production
DEBUG=false
SECRET_KEY=change_me_to_a_64_char_random_string_openssl_rand_hex_32

# ─── Database ───────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=autopilot
POSTGRES_USER=autopilot
POSTGRES_PASSWORD=change_me_strong_password

# Full async URL (built automatically by docker-compose)
# DATABASE_URL=postgresql+asyncpg://autopilot:password@db:5432/autopilot

# ─── Redis ──────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@redis:6379/0

# ─── Celery ─────────────────────────────────────────────
CELERY_BROKER_URL=redis://:change_me_redis_password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:change_me_redis_password@redis:6379/2

# ─── JWT Auth ───────────────────────────────────────────
JWT_SECRET_KEY=change_me_jwt_secret_64_chars_minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Frontend ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_APP_URL=http://localhost

# ─── Google Fit OAuth ───────────────────────────────────
# Register at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost/api/auth/google/callback

# ─── Web Push (VAPID) ───────────────────────────────────
# Generate with: python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.public_key, v.private_key)"
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_CLAIMS_EMAIL=admin@yourdomain.com

# ─── Stripe (Monetization) ──────────────────────────────
STRIPE_SECRET_KEY=sk_live_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRO_PRICE_ID=price_your_pro_plan_id

# ─── Open-Meteo (Free, no key needed) ──────────────────
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1

# ─── Security ───────────────────────────────────────────
# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost,http://localhost:3000
# Rate limit per user per minute
RATE_LIMIT_PER_MINUTE=100

# ─── ML Engine ──────────────────────────────────────────
MODEL_ARTIFACTS_DIR=/ml/artifacts
MIN_DAYS_FOR_ML=7                        # days before switching from rules to ML
RETRAIN_INTERVAL_DAYS=7

# ─── Logging ────────────────────────────────────────────
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                          # json | text
